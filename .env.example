# --- IA (Anthropic) -------------------------------------------------------
# Sin clave, ARM funciona en "modo demo" con un agente de reglas.
ANTHROPIC_API_KEY=
# Modelo que conversa con los compradores y modelo para tareas masivas.
ARM_CHAT_MODEL=claude-sonnet-5-5
ARM_FAST_MODEL=claude-haiku-5-5
# low | medium | high
ARM_CHAT_EFFORT=low

# --- Base de datos --------------------------------------------------------
# Vacío = base local embebida (PGlite) en ./.data. En producción: Postgres
# (Supabase, Neon, Railway...).
DATABASE_URL=

# --- Seguridad --------------------------------------------------------------
# Cadena larga y aleatoria para firmar sesiones.
AUTH_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Protege los endpoints /api/cron/* (seguimientos y resumen diario).
CRON_SECRET=cambia-esto-tambien

# --- WhatsApp Business (Meta Cloud API) -----------------------------------
# Opcional. Cada inmobiliaria guarda su phone_number_id en Ajustes.
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=arm-verify

# --- Voz (opcional, ElevenLabs) ---------------------------------------------
# Resumen del día en audio (Text to Speech) y, si la clave tiene permiso
# Speech to Text, dictado grabado que funciona en cualquier navegador.
ELEVENLABS_API_KEY=
# Opcional: voz concreta (si no, usa una voz propia/predefinida de la cuenta)
ELEVENLABS_VOICE_ID=
